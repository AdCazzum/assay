# Hedera testnet (pay / bond / slash)
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# ecdsa (portal default) | ed25519 | omit for a DER-encoded key
HEDERA_KEY_TYPE=ecdsa
HEDERA_NETWORK=testnet

# A SECOND testnet account, so payments and bonds are real transfers rather than
# self-transfers. This matters more than it looks: a self-transfer nets to zero in
# the mirror node's transfer list, so confirmPayment cannot verify the amount on
# one. Create it with packages/payments/scripts/create-account.ts.
HEDERA_PAY_TO_ACCOUNT_ID=
HEDERA_BOND_ACCOUNT_ID=
HEDERA_CHALLENGER_ACCOUNT_ID=

# Sepolia wallet that owns the ENS parent name (manifest + reputation writes)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ENS_PARENT_NAME=assay.eth

# The Graph Token API (mainnet, read-only)
GRAPH_API_KEY=

# --- Demo run-sheet knobs (issue #64), all optional ---
# The good provider apps/mcp/agent/prompt.md discovers and reset-demo-state.ts
# resets. Defaults to "rugscore" (i.e. rugscore.${ENS_PARENT_NAME}); no need to
# set this unless the run sheet points the demo at a different subname.
# DEMO_PROVIDER_LABEL=rugscore
# Bond multiple reset-demo-state.ts writes (bondHbar = manifest priceHbar * this). Defaults to 6.
# DEMO_BOND_MULTIPLE=6
# The sacrificial subname apps/watchdog challenges and slashes during rehearsals.
# Must differ from the good provider above, or rehearsals re-damage the demo's
# opening state. Defaults to "liar" (i.e. liar.${ENS_PARENT_NAME}).
# WATCHDOG_PROVIDER_NAME=liar.assay.eth
